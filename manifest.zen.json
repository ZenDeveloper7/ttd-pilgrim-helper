{
  "manifest_version": 3,
  "name": "TTD Pilgrim Helper",
  "version": "0.2.0",
  "description": "Schedule a TTD seva booking and fill pilgrim details up to payment.",
  "permissions": ["storage", "activeTab", "alarms", "tabs"],
  "host_permissions": [
    "https://*.ttdevasthanams.ap.gov.in/*",
    "https://*.ttdsevaonline.com/*"
  ],
  "action": {
    "default_title": "Open TTD Pilgrim Helper",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["plan.js", "background.js"]
  },
  "content_scripts": [{
    "matches": [
      "https://*.ttdevasthanams.ap.gov.in/*",
      "https://*.ttdsevaonline.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "ttd-pilgrim-helper@local",
      "strict_min_version": "109.0"
    }
  }
}
